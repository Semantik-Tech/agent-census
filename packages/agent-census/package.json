    "copilot",
    "codex"
  ],
  "license": "MIT",
  "author": "JAyokunle Enterprise UG",
  "homepage": "https://github.com/jayokunle/agent-census#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayokunle/agent-census.git"
  },
  "bugs": {
    "url": "https://github.com/jayokunle/agent-census/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
