{
  "theme": "GitHub",
  "mcpServers": {
    "filesystem-spike": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp/agent-census-spike"],
      "env": {},
      "timeout": 30000,
      "trust": false
    },
    "org-proxy-example": {
      "httpUrl": "https://mcp.example.com/org/acme/filesystem-spike",
      "headers": {
        "Authorization": "Bearer $MCP_ENTERPRISE_TOKEN"
      },
      "timeout": 30000,
      "trust": true
    }
  }
}
